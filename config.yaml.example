# Dashboard configuration example.
# Copy to config.yaml and fill in your values.
# String values support $ENV_VAR substitution.

dashboard:
  name: Franco          # Shown in the "Hello, <name>" greeting
  timezone: America/New_York  # IANA timezone for calendar and task due dates

server:
  port: 8080

scheduler:
  refresh_interval: 5m  # How often plugins poll for new data (e.g. 1m, 5m, 1h)

plugins:

  # ── GitHub pull requests and issues ─────────────────────────────────────────
  github:
    enabled: true
    token: $GITHUB_TOKEN  # Personal access token with repo scope
    mention_window_days: 30  # Only show mentions updated in the last N days (0 = no limit)
    team_mentions:           # Teams whose mentions you want to see (org/team-slug)
      - my-org/my-team
    bot_authors:             # Machine accounts GitHub reports as regular users
      - my-machine-user

  # ── GitHub notifications ─────────────────────────────────────────────────────
  notifications:
    enabled: true
    token: $GITHUB_TOKEN
    all: false  # true = include already-read notifications

  # ── GitHub releases ──────────────────────────────────────────────────────────
  releases:
    enabled: true
    token: $GITHUB_TOKEN
    lookahead_days: 30  # How many days back to look for releases
    repos:
      - owner/repo-one
      - owner/repo-two

  # ── Calendar (iCal/WebCal URLs) ──────────────────────────────────────────────
  calendar:
    enabled: true
    lookahead_days: 30
    timezone: America/New_York  # Timezone for floating-time events (no TZID)
    calendars:
      - name: Personal
        url: https://calendar.google.com/calendar/ical/your-calendar-id/basic.ics
        color: "#4285f4"  # Optional hex color for event display
      - name: Work
        url: https://calendar.google.com/calendar/ical/your-work-calendar-id/basic.ics
        color: "#0f9d58"

  # ── Tasks ────────────────────────────────────────────────────────────────────
  tasks:
    enabled: true
    storage_path: /data/tasks.json  # Path inside the container (mapped via volume)

  # ── Service status (Statuspage-compatible endpoints) ─────────────────────────
  status:
    enabled: true
    services:
      - name: GitHub
        url: https://www.githubstatus.com
      - name: Vercel
        url: https://www.vercel-status.com
      - name: AWS
        url: https://health.aws.amazon.com

# ── Push alerts for new GitHub events ──────────────────────────────────────────
# Pushes a notification (browser and/or ntfy) when a NEW actionable GitHub event
# appears. Only items appearing after startup alert — the existing backlog is
# seeded silently, so restarts never flood you.
alerts:
  enabled: true
  state_path: /data/alerts.json  # Seen-set persisted here (map via volume)
  cache_ttl: 72h  # How long an absent item is remembered before it can re-alert as "new"
  rules:
    notifications: true    # new unread GitHub notifications
    review_requests: true  # new PRs where your review is requested
    assigned_issues: true  # new issues assigned to you
  # Skip noisy sources. exclude_authors matches PR/issue authors (e.g. bots);
  # notifications carry no author so use exclude_repos to mute a whole repo.
  exclude_authors:
    - dependabot[bot]
    - renovate[bot]
  exclude_repos: []
  exclude_bots: true  # skip PRs/issues from bots (GitHub Apps, [bot] logins, github.bot_authors)
  channels:
    browser:
      enabled: true   # native browser notifications while the dashboard tab is open
    ntfy:
      enabled: true
      server: https://ntfy.sh  # or your self-hosted ntfy instance
      topic: $NTFY_TOPIC       # subscribe to this topic in the ntfy app
